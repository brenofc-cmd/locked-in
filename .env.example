# Copy to .env.local and fill in values from the Supabase dashboard
# (Project Settings -> API). Never commit .env.local.
#
# Only PUBLIC values belong in NEXT_PUBLIC_* variables. They are shipped to the
# browser. Server secrets (service_role / secret keys) must never use this prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
