# Copy to .env.local and fill in values from the Supabase dashboard
# (Project Settings -> API). Never commit .env.local.
#
# Only PUBLIC values belong in NEXT_PUBLIC_* variables. They are shipped to the
# browser. Server secrets (service_role / secret keys) must never use this prefix.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, production (Vercel): the public site origin used in auth email
# links (confirmation, password reset), e.g. https://lockedin.example.
# Leave unset locally: the request origin is used.
SITE_URL=

# V2 Phase 10 (docs/WEB_PUSH.md): the Web Push (VAPID) PUBLIC key of the
# matching Supabase project, read from its Vault (`push_vapid_public_key`).
# Public by design. The private key is generated and kept in Supabase Vault
# and never appears in any environment variable, file or log.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
